# Copy to .env for local use. NEVER commit a real .env file (git ignores them).
# On Render you type these names/values into the dashboard instead (Environment tab).

# ===== REQUIRED, SERVER-ONLY SECRETS =====
DATABASE_URL=
SESSION_SECRET=              # long random text; signs the jewelry designer's private cookie. Server will not start without it.
CLERK_SECRET_KEY=            # starts with sk_  (secret: never use it in frontend code)
CLERK_PUBLISHABLE_KEY=       # starts with pk_  (same value as VITE_CLERK_PUBLISHABLE_KEY)

# ===== REQUIRED, PUBLIC (baked into the website at BUILD time; safe to be public) =====
VITE_CLERK_PUBLISHABLE_KEY=  # starts with pk_

# ===== OPTIONAL =====
TUZAKAI_ADMIN_USER_IDS=      # Clerk user ID(s), comma-separated, who may use /admin/*. Add after you sign up once.
OPENAI_API_KEY=              # turns on the AI jewelry assistant (pay-per-use). Site works without it.
# OPENAI_BASE_URL=           # only for OpenAI-compatible providers
# LOG_LEVEL=info
# VITE_CLERK_PROXY_URL=      # public; only if you proxy Clerk through your own domain
# WHOP_COMPANY_ID=           # only for the disabled Whop checkout check
# WHOP_PLAN_ID=

# ===== SET AUTOMATICALLY (do not add) =====
# PORT            Render provides it; the server listens on 0.0.0.0:$PORT (default 3000)
# NODE_ENV        production (set in Dockerfile)
# SERVE_STATIC    1 (set in Dockerfile; the server also serves both websites)
# STATIC_ROOT     optional override of where built websites are found (default: current folder)
